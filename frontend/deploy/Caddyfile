{$SITE_ADDRESS::80} {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	# 保留 /api 前缀，立即刷新 SSE 响应，不设置代理请求体上限。
	@api path /api /api/*
	handle @api {
		reverse_proxy backend:8080 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
