# 配置读取进程环境变量；此文件是供本地终端导出变量的示例。
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://knownote:knownote@localhost:5432/knownote?sslmode=disable
JWT_SECRET=
DATA_DIR=./data
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBED_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_TTS_MODEL=
LLM_TTS_VOICES=alloy,echo
CORS_ORIGINS=http://localhost:5173
# LibreOffice 可执行文件路径；留空自动查找 PATH 和 macOS 默认安装位置。
SOFFICE_PATH=
# 额外的中文字体文件或目录（冒号分隔）。无界面 LibreOffice 读不到系统字体时用于 Word/PPT 预览，留空会自动查找 macOS / Linux / Windows 常见中文字体及 backend/fonts 目录
SOFFICE_FONT_PATHS=
# 默认 local；配置为 oss 时使用私有 Bucket。
STORAGE_DRIVER=
# OSS 地域，例如 cn-hangzhou。
OSS_REGION=
# 可选自定义或内网 Endpoint；浏览器必须能访问签名 URL 的域名。
OSS_ENDPOINT=
# 私有 Bucket 名称。
OSS_BUCKET=
# RAM 子账号凭据，仅通过环境变量配置，禁止提交真实值。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 对象键前缀，留空默认 knownote/。
OSS_PREFIX=
