# 生产配置：密钥一律留空待填；模型可在 /admin 热更新，无需重启。
# CHAT/EMBED 未配置 Key 时使用 Fake LLM（不会调用真实模型）；新能力配置优先，空值回退旧 LLM_*。
# TTS 未配置模型/Key 时无真实合成；ASR 未配置且无百炼回退时隐藏麦克风。
# 配置读取进程环境变量；此文件是供本地终端导出变量的示例。
# 以下运行参数由生产 Compose 覆盖；独立运行时留空使用开发默认值。
APP_ENV=
PORT=
DATABASE_URL=
# 管理员邮箱，逗号分隔；未配置且没有管理员时，最早注册用户成为管理员。
ADMIN_EMAILS=
# 默认管理员口令（至少 10 个字符）：与 ADMIN_EMAILS 的第一个邮箱配套，首次启动时若该账号不存在则自动创建；
# 已存在则不会覆盖口令。生产请用 scripts/init-env.sh 生成随机值，不要使用弱口令或提交真实值。
ADMIN_PASSWORD=
# 数据库模型密钥的加密主密钥；留空时从 JWT_SECRET 派生，生产环境请持久配置。
# 生产必须独立生成并持久保存，不能随更新轮换。
# 更换主密钥后原密文无法解密，会回退到环境变量，需重新保存密钥。
SETTINGS_ENCRYPTION_KEY=
# 生产必须独立生成并填写（openssl rand -hex 32）；留空或少于32字节会拒绝启动。
JWT_SECRET=
DATA_DIR=
# 以下旧变量继续作为各能力的回退配置；新变量非空时优先。
# 地址和模型留空使用内置默认；Key 留空启用 Fake。生产真实调用需填写对应地址、模型与 Key。
# 留空默认值：https://api.openai.com/v1。
LLM_BASE_URL=
LLM_API_KEY=
# 留空默认值：gpt-4o-mini。
LLM_CHAT_MODEL=
# 留空默认值：text-embedding-3-small。
LLM_EMBED_MODEL=
LLM_TTS_MODEL=
# 留空默认值：alloy,echo。
LLM_TTS_VOICES=
# DeepSeek 对话 + 百炼向量示例：按注释填写地址/模型，密钥仅安全注入。
# DeepSeek 官方：https://api-docs.deepseek.com/updates/
# deepseek-flash 当前对应 V4.1 Flash（较新、快速、支持视觉理解）；推荐日常问答。
# deepseek-v4-pro 对应上一代 V4 Pro，官方按用户需求继续提供，适合既有 Pro 工作流对照。
# 本系统只使用文本对话，不传图像输入；准确性/延迟需以自己的资料验证。
# 填 https://api.deepseek.com
CHAT_BASE_URL=
CHAT_API_KEY=
# 填 deepseek-flash；DeepSeek 地址下未指定模型时也默认 deepseek-flash。
CHAT_MODEL=
# 填 deepseek-flash,deepseek-v4-pro；留空只开放 CHAT_MODEL，重复值自动去除。
CHAT_MODELS=
# 百炼北京：填 https://你的业务空间ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 旧公共地址 https://dashscope.aliyuncs.com/compatible-mode/v1 仍兼容，地域须与 Key 一致。
EMBED_BASE_URL=
EMBED_API_KEY=
# 填 text-embedding-v4。官方也已提供 qwen3.7-text-embedding，当前示例采用 v4。
# v4 支持 2048/1536/1024(原生默认)/768/512/256/128/64，每批最多10条，每条8192 Token。
# 本项目 HNSW 上限2000维，推荐1536保持现有库一致；请求会显式发送 dimensions。
EMBED_MODEL=
# 留空默认值：1536。
EMBEDDING_DIM=
# 可选通用 TTS 能力；模型或密钥未配置时不提供真实语音合成。
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
# 可用音色，逗号分隔，例如 alloy,echo。
TTS_VOICES=
# 对话输入框语音识别：只有地址和密钥均可用时启用；不配置时隐藏麦克风。
# 对应字段留空时，仅在 EMBED_BASE_URL 域名含 aliyuncs.com 时回退 EMBED_BASE_URL / EMBED_API_KEY。
# 百炼示例：https://dashscope.aliyuncs.com/compatible-mode/v1，地域须与 Key 一致。
ASR_BASE_URL=
ASR_API_KEY=
# 留空默认 qwen3-asr-flash。
ASR_MODEL=
# 图像扩展点：openai 或 dashscope；留空关闭，没有 Key 的内部调用使用 Fake PNG。
# dashscope 在此预留 OpenAI 兼容适配，原生异步文生图协议尚未接入。
IMAGE_PROVIDER=
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
# 按北京时间每日重置；对话请求包含摘要、概要、工作室脚本；0表示不限。
# 留空默认值：200。
QUOTA_DAILY_CHAT_REQUESTS=
# 各能力合计 Token，优先上游用量，缺失时按 Unicode 字符数保守估算。
# 留空默认值：200000。
QUOTA_DAILY_TOKENS=
# 单进程所有能力合计并发，每用户另限制每分钟20次对话生成。
# 留空默认值：8。
LLM_MAX_CONCURRENCY=
# 留空默认值：http://localhost:5173。
CORS_ORIGINS=
# LibreOffice 可执行文件路径；留空自动查找 PATH 和 macOS 默认安装位置。
SOFFICE_PATH=
# 额外的中文字体文件或目录（冒号分隔）。无界面 LibreOffice 读不到系统字体时用于 Word/PPT 预览，留空会自动查找 macOS / Linux / Windows 常见中文字体及 backend/fonts 目录
SOFFICE_FONT_PATHS=
# 留空默认 local（持久数据卷）；选 oss 时地域、Bucket、AK/SK 必须齐全，否则启动失败。
STORAGE_DRIVER=
# 使用 oss 时生产必须填写地域，例如 cn-hangzhou；local 时留空。
OSS_REGION=
# 可选自定义或内网 Endpoint；浏览器必须能访问签名 URL 的域名。
OSS_ENDPOINT=
# 使用 oss 时生产必须填写私有 Bucket 名称。
OSS_BUCKET=
# 使用 oss 时生产必须填写 RAM 子账号凭据；local 时可留空，禁止提交真实值。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 对象键前缀，留空默认 knownote/。
OSS_PREFIX=
