# 复制为 .env 后填写；占位符不能原样用于生产。不要提交 .env。
# 用 openssl rand -hex 32 生成数据库密码，JWT 和加密密钥分别独立生成。
POSTGRES_PASSWORD=<用openssl生成的64位十六进制密码>
# 仅 IP 访问填 :80；HTTPS 填域名（不带协议或路径）。
SITE_ADDRESS=<填:80或域名>
# 填浏览器访问来源，例如 http://服务器IP 或 https://域名，多个用逗号分隔。
CORS_ORIGINS=<实际访问来源>
# 常规部署填 80 和 443；留空时 Compose 也采用这两个默认端口。
HTTP_PORT=<宿主机HTTP端口>
HTTPS_PORT=<宿主机HTTPS端口>
